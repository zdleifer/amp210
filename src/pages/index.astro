---
import '../styles/global.css';
const title = "AMP 210 Istanbul Reunion | October 22–25, 2026";
const description = "AMP 210 gathers in Istanbul, October 22–25, 2026. Register by August 7.";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" />

  <!-- Cormorant Garamond -->
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap" rel="stylesheet">

  <!-- GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-EZKB87TNLK"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-EZKB87TNLK');
  </script>

  <style>
    .photo-card { cursor: pointer; overflow: hidden; }
    .photo-card img { transition: transform 0.4s ease; }
    .photo-card:hover img { transform: scale(1.04); }
    .img-text { text-shadow: 0 1px 6px rgba(0,0,0,0.9), 0 2px 12px rgba(0,0,0,0.6); }

    #lightbox { display:none; position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,0.93);
      align-items:center; justify-content:center; flex-direction:column; padding:24px; }
    #lightbox.open { display:flex; }
    #lightbox img { max-width:100%; max-height:80vh; object-fit:contain; border-radius:4px; }
    #lightbox-caption { color:rgba(255,255,255,0.85); margin-top:16px; font-size:0.9rem;
      font-family:'Inter',sans-serif; text-align:center; max-width:600px; }
    #lightbox-close { position:fixed; top:20px; right:24px; color:white; font-size:1.8rem;
      cursor:pointer; line-height:1; opacity:0.7; }
    #lightbox-close:hover { opacity:1; }

    .day-photo { width:100%; aspect-ratio:16/9; object-fit:cover; cursor:pointer; }
    .day-photo:hover { opacity:0.92; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes countUp {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @media (max-width: 600px) {
      #whos-coming-list, #whos-coming-empty > div {
        grid-template-columns: 1fr !important;
      }
    }
    .wc-card {
      display: flex; align-items: center; gap: 16px;
      background: white; border: 1px solid #e8e5e0; border-radius: 10px;
      padding: 18px 22px;
      animation: fadeUp 0.4s ease both;
    }
    .wc-avatar {
      width: 52px; height: 52px; flex: 0 0 52px;
      border-radius: 50%; background: #8B1A1A;
      display: flex; align-items: center; justify-content: center;
    }
    .wc-initial {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 22px; font-weight: 500; color: white; line-height: 1;
    }
    .wc-content { min-width: 0; flex: 1; }
    .wc-name {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 20px; font-weight: 500; color: #1a1a1a;
      margin: 0; letter-spacing: 0.01em; line-height: 1.2;
    }
    .wc-badge {
      font-family: 'Helvetica Neue', Helvetica, sans-serif;
      font-size: 10px; font-weight: 700; color: #8B1A1A;
      letter-spacing: 0.12em; margin-left: 8px; vertical-align: middle;
    }
    .wc-quote {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 14px; font-style: italic; color: oklch(52% 0.015 30);
      margin: 5px 0 0; line-height: 1.4;
      overflow: hidden; display: -webkit-box;
      -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    }
  </style>
</head>

<body class="bg-white text-[#1C1C1C]">

  <!-- LIGHTBOX -->
  <div id="lightbox" onclick="closeLightbox(event)">
    <span id="lightbox-close" onclick="closeLightbox()">&times;</span>
    <img id="lightbox-img" src="" alt="" />
    <p id="lightbox-caption"></p>
  </div>

  <!-- STICKY NAV -->
  <header id="top" class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-[#E0DDDA]">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span style="font-family:'EB Garamond',Georgia,serif; font-size:1.15rem; font-weight:500; color:#A51C30;">AMP 210</span>
        <span class="text-[#E0DDDA] hidden sm:inline">|</span>
        <span class="text-[#6B6B6B] text-xs font-medium tracking-wide hidden sm:inline">Istanbul 2026</span>
      </div>
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a href="#experience" class="hover:text-[#A51C30] transition-colors">Experience</a>
        <a href="#itinerary" class="hover:text-[#A51C30] transition-colors">Itinerary</a>
        <a href="#hotel" class="hover:text-[#A51C30] transition-colors">Hotel</a>
        <a href="#gallery" class="hover:text-[#A51C30] transition-colors">Gallery</a>
        <a href="#cost" class="hover:text-[#A51C30] transition-colors">Cost</a>
        <a href="#flights" class="hover:text-[#A51C30] transition-colors">Flights</a>
        <a href="#faq" class="hover:text-[#A51C30] transition-colors">FAQ</a>
        <a href="#whos-coming" class="hover:text-[#A51C30] transition-colors flex items-center gap-1.5">Who's Coming<span id="nav-count-badge" class="hidden px-2 py-0.5 rounded-full bg-[#A51C30] text-white text-xs font-medium leading-none"></span></a>
        <a href="#register" class="ml-2 px-5 py-2 bg-[#A51C30] text-white rounded hover:bg-[#7a1424] transition-colors">Register</a>
      </nav>
      <!-- Mobile: hamburger + register -->
      <div class="md:hidden flex items-center gap-3">
        <a href="#whos-coming" id="mobile-count-badge" class="hidden items-center gap-1.5 text-sm font-medium text-[#1C1C1C] hover:text-[#A51C30] transition-colors"><span id="mobile-count-num"></span><span class="text-[#A51C30]">attending</span></a>
        <a href="#register" class="px-4 py-2 bg-[#A51C30] text-white text-sm font-medium rounded">Register</a>
        <button id="nav-toggle" onclick="toggleMobileNav()" aria-label="Menu" class="p-1">
          <svg id="icon-open" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="7" x2="21" y2="7"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="17" x2="21" y2="17"/>
          </svg>
          <svg id="icon-close" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
            <line x1="4" y1="4" x2="20" y2="20"/><line x1="20" y1="4" x2="4" y2="20"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile nav drawer -->
  <div id="mobile-nav" class="hidden md:hidden fixed inset-x-0 z-40 bg-white shadow-lg border-b border-[#E0DDDA]" style="top:64px;">
    <nav class="flex flex-col">
      <a href="#experience" onclick="closeMobileNav()" class="px-6 py-4 text-base font-medium border-b border-[#E0DDDA] hover:bg-[#F8F7F4] hover:text-[#A51C30] transition-colors">Experience</a>
      <a href="#itinerary" onclick="closeMobileNav()" class="px-6 py-4 text-base font-medium border-b border-[#E0DDDA] hover:bg-[#F8F7F4] hover:text-[#A51C30] transition-colors">Itinerary</a>
      <a href="#hotel" onclick="closeMobileNav()" class="px-6 py-4 text-base font-medium border-b border-[#E0DDDA] hover:bg-[#F8F7F4] hover:text-[#A51C30] transition-colors">Hotel</a>
      <a href="#gallery" onclick="closeMobileNav()" class="px-6 py-4 text-base font-medium border-b border-[#E0DDDA] hover:bg-[#F8F7F4] hover:text-[#A51C30] transition-colors">Gallery</a>
      <a href="#cost" onclick="closeMobileNav()" class="px-6 py-4 text-base font-medium border-b border-[#E0DDDA] hover:bg-[#F8F7F4] hover:text-[#A51C30] transition-colors">Cost</a>
      <a href="#flights" onclick="closeMobileNav()" class="px-6 py-4 text-base font-medium border-b border-[#E0DDDA] hover:bg-[#F8F7F4] hover:text-[#A51C30] transition-colors">Flights</a>
      <a href="#faq" onclick="closeMobileNav()" class="px-6 py-4 text-base font-medium border-b border-[#E0DDDA] hover:bg-[#F8F7F4] hover:text-[#A51C30] transition-colors">FAQ</a>
      <a href="#whos-coming" onclick="closeMobileNav()" class="px-6 py-4 text-base font-medium border-b border-[#E0DDDA] hover:bg-[#F8F7F4] hover:text-[#A51C30] transition-colors">Who's Coming</a>
      <div class="px-6 py-4">
        <a href="#register" onclick="closeMobileNav()" class="block w-full py-3 bg-[#A51C30] text-white text-base font-medium rounded text-center hover:bg-[#7a1424] transition-colors">Register Now</a>
      </div>
    </nav>
  </div>

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <img src="/assets/hero.jpg" alt="Istanbul Bosphorus with Ortakoy Mosque and Bosphorus Bridge"
      class="absolute inset-0 w-full h-full object-cover object-center" />
    <div class="absolute inset-0" style="background:linear-gradient(to bottom, rgba(8,18,35,0.45) 0%, rgba(8,18,35,0.70) 100%);"></div>

    <div class="relative z-10 text-center text-white px-6 max-w-4xl mx-auto">
      <p style="font-family:'EB Garamond',Georgia,serif; font-size:clamp(1.1rem,2.5vw,1.5rem); color:white; letter-spacing:0.25em; font-weight:400;" class="mb-6">AMP 210</p>
      <h1 style="font-family:'EB Garamond',Georgia,serif; font-size:clamp(2.8rem,7vw,5.5rem); font-weight:500; line-height:1.1;" class="mb-6">
        The Magic Continues<br />in Istanbul
      </h1>
      <p style="font-size:clamp(1rem,2vw,1.2rem); font-weight:300; color:rgba(255,255,255,0.82);" class="mb-4 tracking-wide">
        October 22&ndash;25, 2026 &nbsp;&middot;&nbsp; Swissôtel The Bosphorus
      </p>
      <p style="font-size:0.82rem; color:rgba(255,255,255,0.5);" class="mb-10 tracking-widest uppercase">AMP 210 Reunion</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="#register" class="px-8 py-4 bg-[#A51C30] text-white font-medium rounded hover:bg-[#7a1424] transition-all transform hover:scale-105 text-base"
          onclick="gtag('event','cta_click',{event_category:'hero'})">Register Now</a>
        <a href="#itinerary" class="px-8 py-4 border border-white/30 text-white font-medium rounded hover:bg-white/10 transition-all text-base">View Itinerary</a>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row items-center gap-3 justify-center">
        <div class="inline-flex items-center gap-2 px-5 py-2 rounded-full border border-white/20 bg-white/8">
          <div class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></div>
          <span class="text-sm text-white/80">Registration closes <strong class="text-white">August 7, 2026</strong></span>
        </div>
        <div id="hero-reg-count" class="hidden inline-flex items-center gap-2 px-5 py-2 rounded-full border border-white/20 bg-white/8">
          <div class="w-2 h-2 rounded-full bg-green-400"></div>
          <span class="text-sm text-white/80"><strong id="hero-count-num" class="text-white">0</strong> registered so far</span>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30">
      <span class="text-xs tracking-widest uppercase">Scroll</span>
      <div class="w-px h-8 bg-white/15"></div>
    </div>
  </section>

  <!-- CLASS PHOTO BANNER -->
  <section class="relative overflow-hidden" style="height:480px;">
    <img src="/assets/class-photo-cropped.jpg" alt="AMP 210 cohort, February–May 2026"
      class="w-full h-full object-cover" style="object-position: center 35%;" />
    <div class="absolute inset-0" style="background:linear-gradient(to right, rgba(10,22,40,0.85) 0%, rgba(10,22,40,0.45) 60%, rgba(10,22,40,0.1) 100%);"></div>
    <div class="absolute inset-0 flex items-center px-10 md:px-20">
      <div class="max-w-lg">
        <p class="section-label mb-3 img-text" style="color:rgba(255,255,255,0.6);">AMP 210</p>
        <h2 style="font-family:'EB Garamond',Georgia,serif; font-size:clamp(1rem,5vw,2.8rem); font-weight:400; color:white; line-height:1.2;" class="img-text">
          Together again.<br />This time, Istanbul.
        </h2>
        <div class="w-10 h-0.5 bg-[#A51C30] mt-5 mb-5"></div>
        <p style="color:rgba(255,255,255,0.75); font-size:0.95rem; line-height:1.7;" class="img-text">
          We came together February&ndash;May 2026. Now we reconvene where two continents meet.
        </p>
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section id="experience" class="py-24 px-6 bg-[#F8F7F4]">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-4xl mb-16">
        <p class="section-label mb-4">The Experience</p>
        <h2 style="font-family:'EB Garamond',Georgia,serif; font-size:clamp(1rem,5vw,2.8rem); font-weight:400; line-height:1.2;">
          Three days. One unforgettable city.
        </h2>
        <div class="divider mt-5"></div>
        <p class="text-[#6B6B6B] mt-5 text-base leading-relaxed">
          Istanbul sits where two continents meet, where ancient empires left their mark, and where the Bosphorus runs as the world's most dramatic urban waterway.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <div class="bg-white rounded-lg overflow-hidden border border-[#E0DDDA] photo-card"
          onclick="openLightbox('/assets/yacht-sunset.jpg','Private Bosphorus Yacht Tour, sailing between Europe and Asia at sunset aboard the Ay Yildiz')">
          <img src="/assets/yacht-sunset.jpg" alt="Private Bosphorus yacht tour" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 style="font-family:'EB Garamond',Georgia,serif; font-size:1.2rem;" class="mb-2">Private Bosphorus Yacht Tour</h3>
            <p class="text-[#6B6B6B] text-sm leading-relaxed">A guided private yacht cruise sailing between Europe and Asia as the sun sets over the strait.</p>
          </div>
        </div>

        <div class="bg-white rounded-lg overflow-hidden border border-[#E0DDDA] photo-card"
          onclick="openLightbox('/assets/frankie.jpg','Celebration Dinner at Frankie Galataport, Turkish fine dining in one of Istanbul\'s most celebrated restaurants')">
          <img src="/assets/frankie.jpg" alt="Celebration Dinner at Frankie Galataport" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 style="font-family:'EB Garamond',Georgia,serif; font-size:1.2rem;" class="mb-2">Celebration Dinner</h3>
            <p class="text-[#6B6B6B] text-sm leading-relaxed">An evening of Turkish fine dining at Frankie Galataport, celebrating AMP 210 together in style.</p>
          </div>
        </div>

        <div class="bg-white rounded-lg overflow-hidden border border-[#E0DDDA] photo-card"
          onclick="openLightbox('/assets/hagia-sophia.jpg','Hagia Sophia, a Byzantine masterpiece and one of the world\'s great architectural wonders, seen from above with the Bosphorus behind')">
          <img src="/assets/hagia-sophia.jpg" alt="Hagia Sophia aerial view" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 style="font-family:'EB Garamond',Georgia,serif; font-size:1.2rem;" class="mb-2">Historical Istanbul Tour</h3>
            <p class="text-[#6B6B6B] text-sm leading-relaxed">Guided visits to Hagia Sophia, Topkapi Palace, Blue Mosque, and the Grand Bazaar.</p>
          </div>
        </div>

        <div class="bg-white rounded-lg overflow-hidden border border-[#E0DDDA] photo-card"
          onclick="openLightbox('/assets/hotel.jpg','Swissôtel The Bosphorus, 5-star luxury in Maçka with panoramic views of the Bosphorus strait')">
          <img src="/assets/hotel.jpg" alt="Swissôtel The Bosphorus exterior at dusk" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 style="font-family:'EB Garamond',Georgia,serif; font-size:1.2rem;" class="mb-2">3 Nights Accommodation</h3>
            <p class="text-[#6B6B6B] text-sm leading-relaxed">Bed and breakfast at the 5-star Swissôtel The Bosphorus, Maçka, with panoramic views over the strait.</p>
          </div>
        </div>

        <div class="bg-white rounded-lg overflow-hidden border border-[#E0DDDA] photo-card"
          onclick="openLightbox('/assets/galataport.jpg','Galataport Istanbul, one of the world\'s great waterfront destinations, home to the Istanbul Modern Art Museum')">
          <img src="/assets/galataport.jpg" alt="Galataport Istanbul waterfront" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 style="font-family:'EB Garamond',Georgia,serif; font-size:1.2rem;" class="mb-2">Academic Sessions &amp; Museum</h3>
            <p class="text-[#6B6B6B] text-sm leading-relaxed">Keynotes with Brian Hall and Sunil Gupta at TSKB, followed by a guided tour of Istanbul Modern Art Museum at Galataport.</p>
          </div>
        </div>

        <div class="bg-white rounded-lg overflow-hidden border border-[#E0DDDA] photo-card"
          onclick="openLightbox('/assets/grand-bazaar.jpg','Grand Bazaar, Istanbul, one of the world\'s oldest and largest covered markets, with over 4,000 shops under its vaulted ceilings')">
          <img src="/assets/grand-bazaar.jpg" alt="Grand Bazaar Istanbul interior with lanterns" class="w-full h-48 object-cover" />
          <div class="p-6">
            <h3 style="font-family:'EB Garamond',Georgia,serif; font-size:1.2rem;" class="mb-2">Grand Bazaar &amp; All-Day Transport</h3>
            <p class="text-[#6B6B6B] text-sm leading-relaxed">Free time in the Grand Bazaar plus private group transportation covering every transfer across all three days.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- YACHT FULL-BLEED BANNER -->
  <section class="relative overflow-hidden" style="height:480px;">
    <img src="/assets/yacht-deck.jpg" alt="Private yacht deck on the Bosphorus with Turkish flag"
      class="w-full h-full object-cover object-center" style="cursor:pointer;"
      onclick="openLightbox('/assets/yacht-deck.jpg','Aboard the Ay Yildiz, our private yacht on the Bosphorus, with the Fatih Sultan Mehmet Bridge in the background')" />
    <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(8,18,35,0.85) 0%, rgba(8,18,35,0.25) 60%);"></div>
    <div class="absolute bottom-0 left-0 right-0 p-10 md:p-16">
      <p class="section-label mb-3 img-text" style="color:rgba(255,255,255,0.6);">Friday, October 23</p>
      <h2 style="font-family:'EB Garamond',Georgia,serif; font-size:clamp(1rem,5vw,2.8rem); font-weight:400; color:white; line-height:1.2;" class="img-text">
        Private Bosphorus Yacht Tour
      </h2>
      <p style="color:rgba(255,255,255,0.75); font-size:0.95rem;" class="mt-3 img-text">
        17:30&ndash;19:30 &nbsp;&middot;&nbsp; Sailing from Galataport between Europe and Asia
      </p>
    </div>
  </section>

  <!-- ITINERARY -->
  <section id="itinerary" class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-16">
        <p class="section-label mb-4">Day by Day</p>
        <h2 style="font-family:'EB Garamond',Georgia,serif; font-size:clamp(1rem,5vw,2.8rem); font-weight:400; line-height:1.2;">
          Four days where empires met
        </h2>
        <div class="divider mt-5"></div>
      </div>

      <div class="space-y-5">

        <!-- Day 0 -->
        <div class="border border-[#E0DDDA] rounded-lg overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12">
            <div class="lg:col-span-3 p-8 flex flex-col justify-center" style="background:#A51C30;">
              <p style="font-family:'EB Garamond',Georgia,serif; color:rgba(255,255,255,0.65); font-size:0.85rem;">Day 0</p>
              <p style="font-family:'EB Garamond',Georgia,serif; color:white; font-size:1.5rem; line-height:1.2;" class="mt-1">Thursday<br/>October 22</p>
              <p class="mt-3 text-xs tracking-widest text-white/45 uppercase">Arrivals</p>
            </div>
            <div class="lg:col-span-6 p-8 bg-white">
              <h3 style="font-family:'EB Garamond',Georgia,serif; font-size:1.4rem;" class="mb-5">Welcome to Istanbul</h3>
              <div class="space-y-4">
                <div class="flex gap-4">
                  <span class="text-[#6B6B6B] text-sm w-28 shrink-0 pt-0.5">From 14:00</span>
                  <p class="text-sm leading-relaxed">Arrivals and check-in at Swissôtel The Bosphorus. Settle in and take in the views.</p>
                </div>
                <div class="flex gap-4">
                  <span class="text-[#6B6B6B] text-sm w-28 shrink-0 pt-0.5">Evening</span>
                  <p class="text-sm leading-relaxed">Informal dinners to be arranged between attendees (not included). A curated guide to Istanbul's best dining and drinking venues will be provided on arrival.</p>
                </div>
              </div>
            </div>
            <div class="lg:col-span-3 relative overflow-hidden" style="min-height:180px;">
              <img src="/assets/hero.jpg" alt="Istanbul Bosphorus at dusk"
                class="day-photo absolute inset-0 w-full h-full object-cover"
                onclick="openLightbox('/assets/hero.jpg','The Bosphorus at dusk, Istanbul, where Europe meets Asia')" />
              <div class="absolute inset-0 flex items-end p-3" style="background:linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);">
                <p class="text-white text-xs img-text">Bosphorus, Istanbul</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Day 1 -->
        <div class="border border-[#E0DDDA] rounded-lg overflow-hidden">
          <div class="grid grid-cols-1 lg:grid-cols-12">
            <div class="lg:col-span-3 p-8 flex flex-col justify-center" style="background:#7a1424;">
              <p style="font-family:'EB Garamond',Georgia,serif; color:rgba(255,255,255,0.65); font-size:0.85rem;">Day 1</p>
              <p style="font-family:'EB Garamond',Georgia,serif; color:white; font-size:1.5rem; line-height:1.2;" class="mt-1">Friday<br/>October 23</p>
              <p class="mt-3 text-xs tracking-widest text-white/45 uppercase">Academic Day</p>
            </div>
            <div class="lg:col-span-6 p-8 bg-white">
              <h3 style="font-family:'EB Garamond',Georgia,serif; font-size:1.4rem;" class="mb-5">Galataport, Keynotes &amp; Bosphorus by Yacht</h3>
              <div class="space-y-3">
