        <div style="display:flex;align-items:center;gap:16px;background:white;border:1px solid #e8e5e0;border-radius:10px;padding:18px 22px;opacity:0.35;"><div style="width:52px;height:52px;flex-shrink:0;border-radius:50%;background:oklch(85% 0.005 60);"></div><div><div style="height:16px;width:80px;background:oklch(88% 0.005 60);border-radius:3px;margin-bottom:8px;"></div><div style="height:11px;width:150px;background:oklch(90% 0.005 60);border-radius:3px;"></div></div></div>
