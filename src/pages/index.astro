  </section>

  <!-- BACK TO TOP -->
  <button id="back-to-top" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Back to top"
    class="fixed bottom-6 right-5 z-50 w-11 h-11 rounded-full bg-[#A51C30] text-white shadow-lg flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
    style="box-shadow:0 4px 16px rgba(165,28,48,0.4);">
    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="4 12 9 7 14 12"/><line x1="9" y1="7" x2="9" y2="17"/></svg>
  </button>

  <!-- FOOTER -->
  <footer class="py-10 px-6 border-t border-[#E0DDDA] bg-white">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span style="font-family:'EB Garamond',Georgia,serif; font-size:1rem; color:#A51C30; font-weight:500;">AMP 210</span>
        <span class="text-[#E0DDDA]">|</span>
        <span class="text-[#6B6B6B] text-sm">Istanbul 2026</span>
      </div>
      <p class="text-[#6B6B6B] text-sm">Istanbul, October 22&ndash;25, 2026</p>
    </div>
  </footer>

  <script is:inline>
    // Back to top button
    var btt = document.getElementById('back-to-top');
    window.addEventListener('scroll', function() {
      if (window.scrollY > 400) { btt.style.opacity='1'; btt.style.pointerEvents='auto'; }
      else { btt.style.opacity='0'; btt.style.pointerEvents='none'; }
    }, {passive:true});

    function toggleMobileNav() {
      var nav = document.getElementById('mobile-nav');
      var open = document.getElementById('icon-open');
      var close = document.getElementById('icon-close');
      var isHidden = nav.classList.contains('hidden');
      nav.classList.toggle('hidden');
      open.classList.toggle('hidden', !isHidden);
      close.classList.toggle('hidden', isHidden);
    }
    function closeMobileNav() {
      document.getElementById('mobile-nav').classList.add('hidden');
      document.getElementById('icon-open').classList.remove('hidden');
      document.getElementById('icon-close').classList.add('hidden');
    }

    function openLightbox(src, caption) {
      document.getElementById('lightbox-img').src = src;
      document.getElementById('lightbox-caption').textContent = caption;
      document.getElementById('lightbox').classList.add('open');
      document.body.style.overflow = 'hidden';
      gtag('event','photo_view',{event_category:'gallery',event_label:src.split('/').pop()});
    }
    function closeLightbox(e) {
      if (!e || e.target === document.getElementById('lightbox') || e.target === document.getElementById('lightbox-close')) {
        document.getElementById('lightbox').classList.remove('open');
        document.body.style.overflow = '';
      }
    }
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeLightbox({target: document.getElementById('lightbox')});
    });

    function selectAttendance(choice) {
      var val = document.getElementById('attendance-value');
      var radioA = document.getElementById('radio-alone'), dotA = document.getElementById('dot-alone'), optA = document.getElementById('opt-alone');
      var radioG = document.getElementById('radio-guest'), dotG = document.getElementById('dot-guest'), optG = document.getElementById('opt-guest');
      if (choice === 'alone') {
        val.value = 'Alone (1)';
        radioA.style.borderColor='#A51C30'; dotA.classList.remove('hidden'); optA.style.borderColor='#A51C30'; optA.style.background='#fdf5f6';
        radioG.style.borderColor='#E0DDDA'; dotG.classList.add('hidden'); optG.style.borderColor='#E0DDDA'; optG.style.background='';
      } else {
        val.value = 'With Guest (2)';
        radioG.style.borderColor='#A51C30'; dotG.classList.remove('hidden'); optG.style.borderColor='#A51C30'; optG.style.background='#fdf5f6';
        radioA.style.borderColor='#E0DDDA'; dotA.classList.add('hidden'); optA.style.borderColor='#E0DDDA'; optA.style.background='';
      }
    }

    // Email real-time validation
    var emailInput = document.getElementById('email-input');
    var emailOk = document.getElementById('email-ok');
    var emailErr = document.getElementById('email-err');
    function validateEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v); }
    emailInput.addEventListener('blur', function() {
      if (this.value.trim() === '') { emailOk.classList.add('hidden'); emailErr.classList.add('hidden'); return; }
      if (validateEmail(this.value.trim())) {
        emailOk.classList.remove('hidden'); emailErr.classList.add('hidden');
        this.style.borderColor = '#16a34a';
      } else {
        emailOk.classList.add('hidden'); emailErr.classList.remove('hidden');
        this.style.borderColor = '#dc2626';
      }
    });
    emailInput.addEventListener('input', function() {
      if (emailOk.classList.contains('hidden') && emailErr.classList.contains('hidden')) return;
      if (validateEmail(this.value.trim())) {
        emailOk.classList.remove('hidden'); emailErr.classList.add('hidden');
        this.style.borderColor = '#16a34a';
      } else {
        emailOk.classList.add('hidden'); emailErr.classList.remove('hidden');
        this.style.borderColor = '#dc2626';
      }
    });

    document.getElementById('rsvp-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      var form = e.target;
      var errorDiv = document.getElementById('form-error');
      var btn = document.getElementById('submit-btn');
      errorDiv.classList.add('hidden');
      var firstName = form.firstName.value.trim(), lastName = form.lastName.value.trim();
      var email = emailInput.value.trim();
      var phoneCountry = document.getElementById('phone-country').value;
      var phoneNumber = document.getElementById('phone-number').value.trim();
      var phone = phoneCountry + ' ' + phoneNumber;
      var attendance = document.getElementById('attendance-value').value;
      if (!firstName || !lastName || !email || !phoneNumber) {
        errorDiv.textContent = 'Please fill in all required fields.';
        errorDiv.classList.remove('hidden'); return;
      }
      if (!validateEmail(email)) {
        errorDiv.textContent = 'Please enter a valid email address.';
        errorDiv.classList.remove('hidden'); emailInput.focus(); return;
      }
      if (phoneNumber.replace(/\D/g,'').length < 5) {
        errorDiv.textContent = 'Please enter a valid phone number.';
        errorDiv.classList.remove('hidden'); return;
      }
      if (!attendance) {
        errorDiv.textContent = 'Please select whether you are attending alone or bringing a guest.';
        errorDiv.classList.remove('hidden'); return;
      }
      btn.textContent = 'Submitting...'; btn.disabled = true;
      try {
        var res = await fetch('/api/rsvp', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({firstName, lastName, email, phone, attendance, comment: document.getElementById('comment-input').value.trim()})
        });
        var data = await res.json();
        if (res.ok && data.ok) {
          gtag('event','form_submission',{event_category:'registration',event_label:attendance,value:1});
          document.getElementById('rsvp-form').classList.add('hidden');
          document.getElementById('success-state').classList.remove('hidden');
          setTimeout(loadRegistrants, 1500);
        } else {
          errorDiv.textContent = 'Something went wrong. Please try again or contact the committee.';
          errorDiv.classList.remove('hidden'); btn.textContent='Submit Registration'; btn.disabled=false;
        }
      } catch(err) {
        errorDiv.textContent = 'Network error. Please check your connection and try again.';
        errorDiv.classList.remove('hidden'); btn.textContent='Submit Registration'; btn.disabled=false;
      }
    });

    async function loadRegistrants() {
      try {
        var r = await fetch('/api/registrants');
        if (!r.ok) return;
        var d = await r.json();
        var count = d.count || 0;
        var list = d.registrants || [];

        // nav badge (desktop)
        var navBadge = document.getElementById('nav-count-badge');
        if (count > 0) { navBadge.textContent = count; navBadge.classList.remove('hidden'); }

        // mobile count badge
        var mobileBadge = document.getElementById('mobile-count-badge');
        var mobileNum = document.getElementById('mobile-count-num');
        if (count > 0) { mobileNum.textContent = count; mobileBadge.classList.remove('hidden'); mobileBadge.classList.add('flex'); }

        // hero badge
        var heroBadge = document.getElementById('hero-reg-count');
        var heroNum = document.getElementById('hero-count-num');
        if (count > 0) { heroNum.textContent = count; heroBadge.classList.remove('hidden'); }

        // form count (only above 10)
        var formCount = document.getElementById('form-reg-count');
        if (count > 0) {
          formCount.textContent = count + ' classmates have already registered.';
          formCount.classList.remove('hidden');
        }

        // who's coming section
        var countEl = document.getElementById('whos-coming-count');
        var listEl = document.getElementById('whos-coming-list');
        var emptyEl = document.getElementById('whos-coming-empty');
        if (count === 0) {
          countEl.textContent = '';
          emptyEl.style.display = '';
          listEl.innerHTML = '';
        } else {
          countEl.textContent = count + ' classmate' + (count === 1 ? '' : 's') + ' registered';
          emptyEl.style.display = 'none';
          listEl.innerHTML = '';
          list.forEach(function(p, i) {
            var card = document.createElement('div');
            card.style.cssText = 'display:flex;align-items:center;gap:16px;background:white;border:1px solid #e8e5e0;border-radius:10px;padding:18px 22px;animation:fadeUp 0.4s ease both';
            card.style.animationDelay = (i * 60) + 'ms';

            var avatar = document.createElement('div');
            avatar.style.width = '52px';
            avatar.style.height = '52px';
            avatar.style.flex = '0 0 52px';
            avatar.style.borderRadius = '50%';
            avatar.style.background = '#8B1A1A';
            avatar.style.display = 'flex';
            avatar.style.alignItems = 'center';
            avatar.style.justifyContent = 'center';

            var ini = document.createElement('span');
            ini.style.fontFamily = 'Cormorant Garamond, Georgia, serif';
            ini.style.fontSize = '22px';
            ini.style.fontWeight = '500';
            ini.style.color = 'white';
            ini.style.lineHeight = '1';
            ini.textContent = p.name.charAt(0);
            avatar.appendChild(ini);

            var content = document.createElement('div');
            content.style.minWidth = '0';
            content.style.flex = '1';

            var nameEl = document.createElement('p');
            nameEl.style.fontFamily = 'Cormorant Garamond, Georgia, serif';
            nameEl.style.fontSize = '20px';
            nameEl.style.fontWeight = '500';
            nameEl.style.color = '#1a1a1a';
            nameEl.style.margin = '0';
            nameEl.style.letterSpacing = '0.01em';
            nameEl.style.lineHeight = '1.2';
            nameEl.appendChild(document.createTextNode(p.name));

            if (p.withGuest) {
              var badge = document.createElement('span');
              badge.style.fontFamily = 'Helvetica Neue, Helvetica, sans-serif';
              badge.style.fontSize = '10px';
              badge.style.fontWeight = '700';
              badge.style.color = '#8B1A1A';
              badge.style.letterSpacing = '0.12em';
              badge.style.marginLeft = '8px';
              badge.style.verticalAlign = 'middle';
              badge.textContent = '+1';
              nameEl.appendChild(badge);
            }
            content.appendChild(nameEl);

            if (p.comment) {
              var quoteEl = document.createElement('p');
              quoteEl.style.fontFamily = 'Cormorant Garamond, Georgia, serif';
              quoteEl.style.fontSize = '14px';
              quoteEl.style.fontStyle = 'italic';
              quoteEl.style.color = 'oklch(52% 0.015 30)';
              quoteEl.style.margin = '5px 0 0';
              quoteEl.style.lineHeight = '1.4';
              quoteEl.style.overflow = 'hidden';
              quoteEl.style.display = '-webkit-box';
              quoteEl.style.setProperty('-webkit-line-clamp', '2');
              quoteEl.style.setProperty('-webkit-box-orient', 'vertical');
              quoteEl.textContent = '“' + p.comment + '”';
              content.appendChild(quoteEl);
            }

            card.appendChild(avatar);
            card.appendChild(content);
            listEl.appendChild(card);
          });
        }
      } catch(e) {}
    }

    function escHtml(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    if (location.hostname === 'localhost') {
      var mockData = { count: 6, registrants: [
        { name: 'S. Gandhi', comment: 'Cannot wait to be back together!', withGuest: false },
        { name: 'S. Wong', comment: '', withGuest: false },
        { name: 'Z. Leifer', comment: 'Ready to rock and roll...', withGuest: true },
        { name: 'A. Patel', comment: 'Istanbul here we come!', withGuest: false },
        { name: 'M. Chen', comment: '', withGuest: true },
        { name: 'J. Smith', comment: '', withGuest: false },
      ]};
      var _origFetch = window.fetch;
      window.fetch = function(url) {
        if (url === '/api/registrants') return Promise.resolve({ ok: true, json: function() { return Promise.resolve(mockData); } });
        return _origFetch.apply(this, arguments);
      };
    }
    loadRegistrants();
  </script>

</body>
</html>
